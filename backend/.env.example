NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
APP_VERSION=0.1.0

DATABASE_URL=mysql://puntored:puntored@localhost:33060/puntored

COOKIE_NAME=puntored.sid
COOKIE_SECRET=change-this-cookie-secret
COOKIE_SECURE=false
COOKIE_DOMAIN=
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_HOURS=8

BCRYPT_ROUNDS=10
LOGIN_RATE_LIMIT_TTL_SECONDS=60
LOGIN_RATE_LIMIT_LIMIT=5
PROVIDER_ALLOCATION_ENABLED=true
PROVIDER_STUB_BASE_URL=http://localhost:3002
PROVIDER_STUB_API_KEY=change-this-stub-api-key
PROVIDER_CALLBACK_BASE_URL=http://localhost:3000
PROVIDER_ALLOCATION_TIMEOUT_MS=3000
PROVIDER_SHARED_SECRET=change-this-provider-secret
PROVIDER_ACTOR_ID=provider:puntored
